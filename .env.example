# Sincronização entre dispositivos (Firebase Realtime Database)
# Copie para .env.local e preencha com as credenciais do seu projeto Firebase.
# No Netlify, cadastre as mesmas chaves em Site settings > Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
